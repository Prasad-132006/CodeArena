# ==============================================================================
# CodeArena - Environment Configuration
# ==============================================================================

# Backend Settings
PROJECT_NAME="CodeArena"
ENVIRONMENT="development"
DEBUG=true
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="codearena"
POSTGRES_PASSWORD="codearena_secret"
POSTGRES_DB="codearena_db"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# C++ judge queue and validation limits
MAX_SOURCE_CODE_BYTES=100000
JUDGE_IMAGE="codearena-cpp-runner:1.0"
JUDGE_COMPILATION_TIMEOUT_SECONDS=10
JUDGE_QUEUE_NAME="codearena:judge"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Authentication & Security
JWT_SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME="codearena_auth_token"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
AUTH_RATE_LIMIT_PER_MINUTE=30

# LLM / AI Coach (Optional - fallback enabled when empty)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_PROVIDER="fallback"
